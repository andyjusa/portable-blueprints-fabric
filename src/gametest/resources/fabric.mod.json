{
  "schemaVersion": 1,
  "id": "portable_blueprints_test",
  "version": "1.0.0",
  "name": "Portable Blueprints Development Tests",
  "environment": "*",
  "entrypoints": {
    "fabric-gametest": [
      "nimble.portable_blueprints.test.NetworkGameTests",
